# Superset origin, used by the browser and the broker.
SUPERSET_URL=http://localhost:8088

# Broker only; never exposed to the browser.
SUPERSET_USERNAME=admin
SUPERSET_PASSWORD=admin
BROKER_PORT=3001

# Saved widget uuids (GET /api/v1/widget/), rendered with <Widget id>.
EMBED_WIDGET_IDS=
# A widget type an extension contributes, e.g.
# extensions.<publisher>.<name>.<type>. Set it to render one; the page loads
# that extension from Superset at runtime. Guest-token pages also need
# EMBEDDED_EXTENSION_ASSETS_PUBLIC = True on the Superset side.
EMBED_EXTENSION_WIDGET=
# Dataset ids inline widgets may query (the token's `datasets` claim).
EMBED_DATASETS=17

# Inline widgets and the host-owned filter use this dataset. FILTER_COLUMN is
# also the dimension the charts group by, so the host filter narrows them.
#
# In session mode these are a preference, not a promise: the app looks
# FILTER_DATASET_TABLE up by name (example dataset ids shift when the examples
# are reloaded) and replaces any column or metric below that the dataset does
# not actually have. Guest mode cannot read the dataset API, so there these
# values are used as written.
FILTER_DATASET_TABLE=birth_names
FILTER_DATASET_ID=17
FILTER_COLUMN=state
FILTER_VALUES=CA,NY,TX,IL,FL

# The rest of the dataset's shape. Defaults describe Superset's `birth_names`
# example; change them when you point the app at your own dataset.
EMBED_METRIC=sum__num
EMBED_SECOND_METRIC=count
# A numeric column, for the demo that aggregates one ad hoc.
EMBED_METRIC_COLUMN=num
# A low-cardinality column, for the pie and the scoped filter.
EMBED_CATEGORY=gender
EMBED_CATEGORY_VALUES=boy,girl
# A high-cardinality column, for the table's rows.
EMBED_LABEL=name

# session (default): use your Superset login, no backend. guest: use server.mjs broker.
EMBED_AUTH=session
