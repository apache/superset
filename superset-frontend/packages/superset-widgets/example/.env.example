# Superset origin, used by the browser and the broker.
SUPERSET_URL=http://localhost:8088

# Broker only; never exposed to the browser.
SUPERSET_USERNAME=admin
SUPERSET_PASSWORD=admin
BROKER_PORT=3001

# Saved widget uuids (GET /api/v1/widget/), rendered with <Widget id>.
EMBED_WIDGET_IDS=
# Dataset ids inline widgets may query (the token's `datasets` claim).
EMBED_DATASETS=17

# Inline widgets and the host-owned filter use this dataset.
FILTER_DATASET_ID=17
FILTER_COLUMN=state
FILTER_VALUES=CA,NY,TX,IL,FL

# session (default): use your Superset login, no backend. guest: use server.mjs broker.
EMBED_AUTH=session
