# -----------------------------------------------------------------------
# Example .env-local file for running multiple Superset instances
# Copy this file to .env-local and customize for your setup
# -----------------------------------------------------------------------

# Unique project name prevents container/volume conflicts between clones
# Each clone should have a different name (e.g., superset-pr123, superset-feature-x)
COMPOSE_PROJECT_NAME=superset-dev2

# Port offsets for running multiple instances simultaneously
# Instance 1 (default): 80, 8088, 9000, 8080, 8081, 5432, 6379
# Instance 2 example:   81, 8089, 9001, 8082, 8083, 5433, 6380
NGINX_PORT=81
SUPERSET_PORT=8089
NODE_PORT=9001
WEBSOCKET_PORT=8082
CYPRESS_PORT=8083
DATABASE_PORT=5433
REDIS_PORT=6380

# For verbose logging during development:
# SUPERSET_LOG_LEVEL=debug

# -----------------------------------------------------------------------
# AI assistant (optional)
# -----------------------------------------------------------------------
# The assistant stays off until both a URL and a key are set here. Any
# OpenAI-compatible endpoint works, including a private gateway.
#
# SUPERSET_AI_LLM_BASE_URL=https://your-gateway.internal/v1
# SUPERSET_AI_LLM_API_KEY=your-token
#
# Name the models your endpoint serves. A tier you leave unset falls back to
# the default one.
# SUPERSET_AI_MODEL_DEFAULT=gpt-4o-mini
# SUPERSET_AI_MODEL_FAST=gpt-4o-mini
# SUPERSET_AI_MODEL_REASONING=gpt-4o
#
# For an Anthropic endpoint instead of an OpenAI-compatible one:
# SUPERSET_AI_LLM_PROVIDER_CLASS=superset.ai.llm.anthropic.AnthropicProvider
# SUPERSET_AI_MODEL_DEFAULT=claude-sonnet-4-5
#
# Turns run inside the streaming request by default, which needs no extra
# infrastructure. The cost is that reloading the page abandons a turn in flight.
# Switch to the Celery worker to make a run survive its reader going away, so a
# returning client can re-attach to one already in progress. Needs the
# superset-worker container and Redis, both of which the compose stack provides.
# SUPERSET_AI_EXECUTION_MODE=worker
