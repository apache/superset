{
  "name": "superset-websocket",
  "version": "0.0.1",
  "description": "Websocket server application for Superset",
  "type": "module",
  "main": "dist/index.cjs",
  "scripts": {
    "start": "node dist/index.cjs start",
    "test": "npx vitest --run --dir spec",
    "type": "tsc --noEmit",
    "lint-check": "npx oxlint --config oxlint.json",
    "lint": "npm run type && npm run lint-check",
    "dev-server": "npm run build && npm run start",
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node20 --external:bufferutil --external:utf-8-validate --define:import.meta.dirname=__dirname --outfile=dist/index.cjs",
    "format": "oxfmt --write .",
    "format-check": "oxfmt --check ."
  },
  "license": "Apache-2.0",
  "dependencies": {
    "cookie": "^2.0.1",
    "hot-shots": "^17.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "lodash-es": "^4.18.1",
    "winston": "^3.19.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.4.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "globals": "^17.11.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tscw-config": "^1.1.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^24.16.0",
    "npm": "^11.13.0"
  }
}
