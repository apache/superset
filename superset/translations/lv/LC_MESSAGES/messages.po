msgstr "Datu kopas kolonna/metrika, kas atgriež vērtības diagrammas X asī."

msgid "The dataset column/metric that returns the values on your chart's y-axis."
msgstr "Datu kopas kolonna/metrika, kas atgriež vērtības diagrammas Y asī."

msgid ""
"The dataset columns will be automatically synced\n"
